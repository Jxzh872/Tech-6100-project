#End Region

#Region  Activity Attributes 
	#FullScreen: False
	#IncludeTitle: True
#End Region

Sub Process_Globals
	'Global variables accessible across modules
	Dim UDP As UDPSocket
	Dim RPiIP As String = "192.168.1.100" ' Default Raspberry Pi IP address
	Dim RPiPort As Int = 5000 ' Set your target port
End Sub

Sub Globals
	'Global variables for UI elements
	Private jsv1 As JoystickView
	Private l4 As Label
	Private l5 As Label
	Private l6 As Label
	Private txtRPiIP As EditText
	Private btnSetIP As Button
	Private udpPort As EditText
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Activity.LoadLayout("main")

	jsv1.ButtonColor = Colors.White
	jsv1.MainCircleColor = Colors.Black
	jsv1.SecondaryCircleColor = Colors.Gray
	jsv1.SecondaryCircleStrokeWidth = 3
	jsv1.HorizontalLineColor = Colors.Green
	jsv1.HorizontalLineStrokeWidth = 4
	jsv1.VerticalLineColor = Colors.Green
	jsv1.VerticalLineStrokeWidth = 8

	If FirstTime Then
		UDP.Initialize("UDP", 0, 8000)
	End If

End Sub

Sub Activity_Resume

End Sub

Sub Activity_Pause (UserClosed As Boolean)

End Sub

Sub MapAngle(angle As Int) As Int
	If angle < 0 Then
		Return 360 + angle
	Else
		Return angle
	End If
End Sub

Sub jsv1_value_changed(angle As Int, powr As Int, direc As Int)
	Dim mapped_angle As Int = MapAngle(angle) ' Correctly map angle

	l4.Text = mapped_angle
	l5.Text = powr
	l6.Text = direc

	Dim msg As String = mapped_angle & "," & powr
	Dim packet As UDPPacket
	packet.Initialize(msg.GetBytes("UTF8"), RPiIP, RPiPort)
	UDP.Send(packet)
End Sub

Sub btnSetIP_Click
	RPiIP = txtRPiIP.Text
	RPiPort = udpPort.Text
End Sub